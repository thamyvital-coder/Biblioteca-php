# Copie este arquivo para .env e preencha os valores. Nunca publique o .env.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
OLLAMA_API_KEY=
TIKTOK_USERNAME=blox_castz

# Ollama Cloud: modelo e endpoint da API
# O nome do modelo pode variar conforme os modelos disponíveis na sua conta.
OLLAMA_MODEL=gemma4:31b
OLLAMA_API_URL=https://ollama.com/api/chat

# Opcional: limites de fala
ELEVENLABS_MODEL=eleven_multilingual_v2
MAX_REPLY_CHARS=350
MIN_CHAT_INTERVAL_MS=1800
MAX_QUEUE_SIZE=5
DEDUPE_WINDOW_MS=15000

# Ajustes de voz (valores entre 0 e 1)
VOICE_STABILITY=0.45
VOICE_SIMILARITY_BOOST=0.8
VOICE_STYLE=0.35
