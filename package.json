{
  "name": "brasilia-fighter",
  "version": "0.1.0",
  "private": true,
  "description": "Jogo interativo para lives com modo de teste local.",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "start:web": "node server.cjs",
    "pack": "electron-builder --win portable"
  },
  "dependencies": {
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "br.com.brasiliafighter.game",
    "productName": "Brasília Fighter",
    "files": ["main.cjs", "server.cjs", "public/**/*", "package.json"],
    "win": { "target": ["portable"] }
  }
}
